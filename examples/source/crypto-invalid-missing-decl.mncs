mncs 0.8;

// Negative fixture: crypto intrinsics without declared crypto effects
// are rejected (MNE241/MNE244). Authority cannot be assumed.
module examples.crypto_invalid_missing_decl;

fn digest_message(msg: [byte; up_to 64]) -> (result: [byte; up_to 64])
    capability verifier
{
    return sha256_digest(msg);
}

fn check_issuance(
    pubkey: [byte; up_to 64],
    msg: [byte; up_to 64],
    sig: [byte; up_to 64]
) -> (result: bool)
    capability verifier
{
    return ed25519_verify(pubkey, msg, sig);
}
