mncs 0.12;

// Negative fixture: `fs_read_bytes_at` without a declared `fs_read` effect (MNE259).
module examples.fs_bad_read_missing;

fn read_chunk(entry: u64, offset: u64, length: u64) -> (result: [byte; up_to 64])
    capability fs_root
    effect fs_list authorized_by fs_root
{
    return fs_read_bytes_at(entry, offset, length);
}
