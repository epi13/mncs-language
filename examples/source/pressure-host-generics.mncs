mncs 0.16;

// P1-013 / P2-003: host invocation of generic entrypoints.
//
// Every generic function below is callable two ways: from MNCS source
// (explicit `<...>` or inference) and from the host boundary through
// explicit `type_arguments` on the execution request — no hand-written
// wrapper functions. The `probe_same_*` wrappers instantiate the same
// arguments in-language that the corpus names from the host, pinning
// the single-specialization contract: one function, one record, one
// identity, however the instantiation was requested.
//
// Independent expectations (hand-computed):
//   probe_same_fill  = fill 8 with 7, read index 3 = 7
//   probe_same_first = first(42) = 42
//   probe_same_lib   = cross-module fill 4 with 9, read index 1 = 9
//   probe_same_pick  = wrapping sum over [1, 2] ++ [10, 20] = 33
//
// `pick2_sum` takes TWO Nat parameters so host seeding must keep
// positional spelling addresses exact: `<2, 2>` (repeated spelling)
// and `<3, 2>` (unsorted spelling) are different instantiations, and
// neither address may be sorted or deduplicated across positions.
module pressure.host_generics;

use pressure.host_generics.lib as lib;

record Point { x: i64, y: i64 }

fn grow_fill_local<W: Nat>(row: [i64; W], v: i64) -> (result: [i64; W]) {
    iterate i over row carrying out: [i64; W] = row {
        next out = replace(out, i, v);
    }
    return out;
}

fn first_local<T>(value: T) -> (result: T) {
    return value;
}

fn vlen<N: Nat>(view: [byte; up_to N]) -> (result: u64) {
    return view.len;
}

fn id_value<T>(spot: T) -> (result: T) {
    return spot;
}

// Two Nat parameters, traversal-only indexing (proven by construction),
// and wrapping accumulation (total: no overflow obligation), so the
// function is obligation-clean and the experiment can reach PASS —
// leaving host-seeding addresses as the only thing under test.
fn pick2_sum<M: Nat, N: Nat>(a: [i64; M], b: [i64; N]) -> (result: i64) {
    iterate i over a carrying s: i64 = 0 {
        next s = s +% a[i];
    }
    iterate j over b carrying t: i64 = s {
        next t = t +% b[j];
    }
    return t;
}

fn probe_same_fill() -> (result: i64) {
    let base: [i64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
    let full: [i64; 8] = grow_fill_local<8>(base, 7);
    return full[3];
}

fn probe_same_first() -> (result: i64) {
    return first_local<i64>(42);
}

fn probe_same_lib() -> (result: i64) {
    let base: [i64; 4] = [0, 0, 0, 0];
    let full: [i64; 4] = lib.grow_fill(base, 9);
    return full[1];
}

fn probe_same_pick() -> (result: i64) {
    let a: [i64; 2] = [1, 2];
    let b: [i64; 2] = [10, 20];
    return pick2_sum<2, 2>(a, b);
}
