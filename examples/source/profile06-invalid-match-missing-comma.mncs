mncs 0.6;

// Negative fixture (HARNESS-PRESSURE-012): a missing comma between match
// arms is exactly one precise MNP192 diagnostic, not an MNP084 wall.
module examples.profile06_invalid_match_missing_comma;

fn gate(flag: bool) -> (result: i32) {
    return match flag {
        true => 1
        false => 0,
    };
}
