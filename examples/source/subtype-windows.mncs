mncs 0.7;

// One reusable little-endian reader serves differently-sized exact windows:
// the 44-byte, 46-byte, and 22-byte shapes borrow into the reader's
// `[byte; up_to 64]` parameter with no per-width duplication. This is the
// P-010 unlock shape (shared `le.mncs`-style readers across WAV/pack
// windows), proven against mncs.std.encoding.v1.
// Corpus: examples/execution/subtype-windows-corpus.json (generated by
// scripts/gen_subtype_windows_corpus.py).
module examples.subtype.windows;

use mncs.std.encoding.v1;

fn read44(header: [byte; 44]) -> (result: u16) {
    return read_u16_le(header, 20);
}

fn read46(window: [byte; 46]) -> (result: u16) {
    return read_u16_le(window, 20);
}

fn read22(eocd: [byte; 22]) -> (result: u16) {
    return read_u16_le(eocd, 8);
}

fn sig32(local: [byte; 46]) -> (result: u32) {
    return read_u32_le(local, 0);
}

fn nested(header: [byte; 44]) -> (result: u16) {
    return read_u16_le(header, (read44(header) % 40) as u64);
}

fn dup44(header: [byte; 44]) -> (result: [byte; 44]) {
    return header;
}

fn via_call(header: [byte; 44]) -> (result: u16) {
    return read_u16_le(dup44(header), 20);
}

fn via_let(header: [byte; 44]) -> (result: u16) {
    let w: [byte; up_to 64] = header;
    return read_u16_le(w, 0);
}

fn via_return(header: [byte; 44]) -> (result: [byte; up_to 64]) {
    return header;
}
