mncs 0.12;

// Shift/bitwise regression pins for three engine pressures, with
// hand-computed expectations:
//   ENG-0009: `(0xFF0000FF >> 8) & 255 == 0` (channel extraction), and
//     `(0xAB << 8) | 0xCD == 0xABCD` (packing).
//   ENG-0001: u64 `>>` is logical — `(2^64 - 2) >> 1 == 2^63 - 1` and
//     `2^63 >> 1 == 2^62` — on every backend including portable-WASM.
//   ENG-0005: i64 `>>` elaborates and is arithmetic — `-4 >> 1 == -2`
//     and `7 >> 1 == 3`.
module pressure.bitops;

fn unpack_b(px: u32) -> (result: u32) {
    return (px >> 8) & 255;
}

fn pack_hi(hi: u32, lo: u32) -> (result: u32) {
    return (hi << 8) | lo;
}

fn shr_u64(x: u64) -> (result: u64) {
    return x >> 1;
}

fn shr_i64(x: i64) -> (result: i64) {
    return x >> 1;
}

// ENG-0006: u64 arguments with the high bit set cross call boundaries
// intact — `ident(2^64 - 1) == 2^64 - 1` and `ident(2^63) == 2^63`.
fn ident_u64(x: u64) -> (result: u64) {
    return x;
}
