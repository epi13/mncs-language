mncs 0.6;

// Source Profile 0.6 positive fixture: strict conjunction/disjunction in
// guard positions. Both operands are total bool values; evaluation is not
// short-circuited. `a && b || c` parses with && binding tighter than ||;
// chained relational guards (lo <= x && x <= hi) are the canonical use.
module examples.profile06_boolean_operators;

fn pick(a: bool, b: bool, c: bool) -> (result: i32) {
    if a && b || c {
        return 1;
    }
    return 0;
}

fn guard(x: i64, lo: i64, hi: i64) -> (result: bool) {
    return lo <= x && x <= hi;
}
