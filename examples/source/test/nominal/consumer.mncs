mncs 0.10;

// Cross-module nominal-type consumer: every nominal identity below
// (Transport, Phase, Evt) is declared in test.nominal.machine and only
// USED here — in parameters, returns, record construction and projection,
// finite construction and matching, and nested cross-module calls. Both
// unqualified (unique import) and fully-qualified spellings are exercised.
// Corpus: examples/execution/import-nominal-corpus.json (generated by
// scripts/gen_import_nominal_corpus.py).
module test.nominal.consumer;

use test.nominal.machine;

fn launch(armed: bool) -> (result: Transport) {
    let init: Transport = Transport { phase: Phase.stopped, armed: armed };
    return step(init, Evt.play);
}

fn launch_qualified(armed: bool) -> (result: test.nominal.machine.Transport) {
    let init: test.nominal.machine.Transport = test.nominal.machine.Transport { phase: test.nominal.machine.Phase.stopped, armed: armed };
    return test.nominal.machine.step(init, test.nominal.machine.Evt.play);
}

fn describe(state: Transport) -> (result: bool) {
    return match state.phase {
        playing => true,
        stopped => false,
        paused => false,
    };
}

fn phase_of(state: Transport) -> (result: Phase) {
    return state.phase;
}

fn cycle(state: Transport, event: Evt) -> (result: Transport) {
    return step(step(state, event), Evt.stop);
}

fn disarm_after_stop(state: Transport) -> (result: bool) {
    let halted: Transport = step(state, Evt.stop);
    return is_playing(halted);
}

fn arm_then_playing(armed: bool) -> (result: bool) {
    let init: Transport = Transport { phase: Phase.stopped, armed: armed };
    let ready: Transport = arm(init);
    return is_playing(step(ready, Evt.play));
}

fn echo_it(phase: Phase) -> (result: Phase) {
    return echo_phase(phase);
}
