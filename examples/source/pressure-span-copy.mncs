mncs 0.14;

// WEB-P-003 regression: bulk bounded span copy as one total operation.
// `copy_span(dst, dst_at, src, src_at, len)` produces a new sequence equal
// to `dst` except the `len` elements starting at `dst_at`, which become the
// `len` elements of `src` starting at `src_at`. Both inputs are unchanged
// (no aliasing, no input mutation); out-of-window positions keep the
// destination value, and any window arithmetic that wraps or escapes either
// bound is a deterministic runtime failure. The source may be exact or a
// view, so staged and parsed spans copy without remarshal.
module pressure.span_copy;

// Dynamic window over exact byte sequences; the last three reads witness
// that neither input cell was mutated by the copy.
fn copy_bytes(dst_at: u64, src_at: u64, len: u64) -> (result: u64) {
    let dst: [byte; 64] = [1; 64];
    let src: [byte; 64] = [7; 64];
    let out: [byte; 64] = copy_span(dst, dst_at, src, src_at, len);
    return (out[0] as u64) + (out[32] as u64) + (out[63] as u64) + (dst[32] as u64) + (src[32] as u64);
}

// View source: the parsed/staged span copies without remarshal.
fn copy_view_src(n: u64, src_at: u64, len: u64) -> (result: u64) {
    let dst: [byte; 64] = [1; 64];
    let staged: [byte; 64] = [9; 64];
    let window: [byte; up_to 64] = staged[0..n];
    let out: [byte; 64] = copy_span(dst, 8, window, src_at, len);
    return (out[7] as u64) + (out[8] as u64) + (out[11] as u64) + (out[40] as u64);
}

// All-literal window over exact bounds: static evidence, no check.
fn copy_static() -> (result: u64) {
    let dst: [u64; 8] = [0; 8];
    let src: [u64; 8] = [5; 8];
    let out: [u64; 8] = copy_span(dst, 2, src, 0, 4);
    return out[0] + out[1] + out[2] + out[5] + out[6];
}

// Overlapping windows over the same value copy safely in either
// direction: the source is only read, never written, so no
// direction-dependent clobbering is possible.
fn copy_overlap_fwd() -> (result: u64) {
    let buf: [u64; 8] = [3; 8];
    let staged: [u64; 8] = replace(replace(buf, 0, 10), 4, 20);
    let out: [u64; 8] = copy_span(staged, 0, staged, 4, 4);
    return out[0] + out[3] + out[4] + out[7];
}

fn copy_overlap_bwd() -> (result: u64) {
    let buf: [u64; 8] = [3; 8];
    let staged: [u64; 8] = replace(replace(buf, 0, 30), 7, 40);
    let out: [u64; 8] = copy_span(staged, 4, staged, 0, 4);
    return out[0] + out[3] + out[4] + out[7];
}

// Zero-length copy is the identity on the destination value.
fn copy_zero_len() -> (result: u64) {
    let dst: [byte; 8] = [3; 8];
    let src: [byte; 8] = [9; 8];
    let out: [byte; 8] = copy_span(dst, 2, src, 0, 0);
    return (out[0] as u64) + (out[2] as u64) + (out[7] as u64);
}

// Full-width copy.
fn copy_full() -> (result: u64) {
    let dst: [u64; 8] = [0; 8];
    let src: [u64; 8] = [5; 8];
    let out: [u64; 8] = copy_span(dst, 0, src, 0, 8);
    return out[0] + out[7];
}

// Narrower integer width.
fn copy_u16() -> (result: u64) {
    let dst: [u16; 8] = [0; 8];
    let src: [u16; 8] = [1000; 8];
    let out: [u16; 8] = copy_span(dst, 6, src, 2, 2);
    return (out[5] as u64) + (out[6] as u64) + (out[7] as u64);
}

// Boolean elements.
fn copy_bool() -> (result: u64) {
    let dst: [bool; 8] = [false; 8];
    let src: [bool; 8] = [true; 8];
    let out: [bool; 8] = copy_span(dst, 1, src, 0, 3);
    return (out[0] as u64) + (out[1] as u64) + (out[3] as u64) + (out[4] as u64);
}

// Destination window escapes the bound: deterministic failure.
fn copy_oob_dst(dst_at: u64, len: u64) -> (result: u64) {
    let dst: [byte; 16] = [1; 16];
    let src: [byte; 16] = [7; 16];
    let out: [byte; 16] = copy_span(dst, dst_at, src, 0, len);
    return (out[0] as u64);
}

// Source window escapes the source length: deterministic failure.
fn copy_oob_src(src_at: u64, len: u64) -> (result: u64) {
    let dst: [byte; 16] = [1; 16];
    let staged: [byte; 16] = [7; 16];
    let window: [byte; up_to 16] = staged[0..10];
    let out: [byte; 16] = copy_span(dst, 0, window, src_at, len);
    return (out[0] as u64);
}

// Wrapping window arithmetic is a range failure, never an address. The
// offset stays dynamic so the check happens at realization, not at
// elaboration (a literal out-of-range window is MNE271 instead).
fn copy_wrap(huge: u64) -> (result: u64) {
    let dst: [byte; 16] = [1; 16];
    let src: [byte; 16] = [7; 16];
    let out: [byte; 16] = copy_span(dst, huge, src, 0, 1);
    return (out[0] as u64);
}
