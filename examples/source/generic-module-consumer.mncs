mncs 0.10;
module test.generic.consumer;
use test.generic.lib;
use test.generic.lib as lib2;
fn demo_unqualified() -> (result: i64) {
    let p1: test.generic.lib.Point = test.generic.lib.Point { x: 1, y: 2 };
    let p2: test.generic.lib.Point = test.generic.lib.Point { x: 3, y: 4 };
    let xs: [test.generic.lib.Point; 2] = [p1, p2];
    return first<test.generic.lib.Point, 2>(xs).x;
}
fn demo_qualified() -> (result: i64) {
    let p1: test.generic.lib.Point = test.generic.lib.Point { x: 1, y: 2 };
    let p2: test.generic.lib.Point = test.generic.lib.Point { x: 3, y: 4 };
    let xs: [test.generic.lib.Point; 2] = [p1, p2];
    return lib.first<test.generic.lib.Point, 2>(xs).x;
}
fn demo_aliased() -> (result: i64) {
    let p1: test.generic.lib.Point = test.generic.lib.Point { x: 1, y: 2 };
    let p2: test.generic.lib.Point = test.generic.lib.Point { x: 3, y: 4 };
    let xs: [test.generic.lib.Point; 2] = [p1, p2];
    return lib2.first<test.generic.lib.Point, 2>(xs).x;
}
