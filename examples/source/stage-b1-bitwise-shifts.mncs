}

fn shr_u32(value: u32, count: u64) -> (result: u32) {
    return value >> count;
}

fn xor_u64(a: u64, b: u64) -> (result: u64) {
    return a ^ b;
}

fn band_u64(a: u64, b: u64) -> (result: u64) {
    return a & b;
}

fn bor_u64(a: u64, b: u64) -> (result: u64) {
    return a | b;
}

fn shl_u64(value: u64, count: u64) -> (result: u64) {
    return value << count;
}

fn shr_u64(value: u64, count: u64) -> (result: u64) {
    return value >> count;
}

fn xor_i8(a: i8, b: i8) -> (result: i8) {
    return a ^ b;
}

fn band_i8(a: i8, b: i8) -> (result: i8) {
    return a & b;
}

fn bor_i8(a: i8, b: i8) -> (result: i8) {
