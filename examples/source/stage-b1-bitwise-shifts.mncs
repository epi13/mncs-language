mncs 0.9;

// Stage B1: total integer bitwise operators and shifts, all widths.
// Bitwise `^ & |` are pure (no overflow obligations); shift counts
// are u64 and reduce modulo the value width, so oversized counts
// are well-defined on every backend, not poison or UB.
module examples.stage.bitwise;

fn xor_u8(a: u8, b: u8) -> (result: u8) {
    return a ^ b;
}

fn band_u8(a: u8, b: u8) -> (result: u8) {
    return a & b;
}

fn bor_u8(a: u8, b: u8) -> (result: u8) {
    return a | b;
}

fn shl_u8(value: u8, count: u64) -> (result: u8) {
    return value << count;
}

fn shr_u8(value: u8, count: u64) -> (result: u8) {
    return value >> count;
}

fn xor_u16(a: u16, b: u16) -> (result: u16) {
    return a ^ b;
}

fn band_u16(a: u16, b: u16) -> (result: u16) {
    return a & b;
}

fn bor_u16(a: u16, b: u16) -> (result: u16) {
    return a | b;
}

fn shl_u16(value: u16, count: u64) -> (result: u16) {
    return value << count;
}

fn shr_u16(value: u16, count: u64) -> (result: u16) {
    return value >> count;
}

