}

fn xor_i16(a: i16, b: i16) -> (result: i16) {
    return a ^ b;
}

fn band_i16(a: i16, b: i16) -> (result: i16) {
    return a & b;
}

fn bor_i16(a: i16, b: i16) -> (result: i16) {
