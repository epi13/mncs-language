    },
    {
      "id": "unicode-escape-split-between-chunks",
      "request": {
        "schema_version": "0.1",
        "target": { "module": "examples.json_stream_probe", "function": "inspect_split" },
        "arguments": [
          { "sequence": { "values": [
            { "byte": { "value": 34 } }, { "byte": { "value": 92 } },
            { "byte": { "value": 117 } }, { "byte": { "value": 48 } },
