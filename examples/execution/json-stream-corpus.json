{
  "schema_version": "0.2",
  "name": "json-stream-probe",
  "description": "Scalar-state chunked JSON validation probe.",
  "cases": [
    {
      "id": "valid-true",
      "request": {
        "schema_version": "0.1",
        "target": { "module": "examples.json_stream_probe", "function": "inspect" },
        "arguments": [{ "sequence": { "values": [
          { "byte": { "value": 116 } }, { "byte": { "value": 114 } },
          { "byte": { "value": 117 } }, { "byte": { "value": 101 } }
        ] } }],
        "step_budget": 100000,
        "policy": { "effects": "unsupported" }
      },
      "expected": [{ "integer": { "value": 1, "type": { "bits": 64, "signed": true } } }],
      "expected_status": "returned"
    },
    {
      "id": "valid-nested-empty",
      "request": {
        "schema_version": "0.1",
        "target": { "module": "examples.json_stream_probe", "function": "inspect" },
        "arguments": [{ "sequence": { "values": [
          { "byte": { "value": 123 } }, { "byte": { "value": 34 } },
          { "byte": { "value": 97 } }, { "byte": { "value": 34 } },
          { "byte": { "value": 58 } }, { "byte": { "value": 123 } },
          { "byte": { "value": 34 } }, { "byte": { "value": 98 } },
          { "byte": { "value": 34 } }, { "byte": { "value": 58 } },
          { "byte": { "value": 91 } }, { "byte": { "value": 93 } },
          { "byte": { "value": 125 } }, { "byte": { "value": 125 } }
        ] } }],
        "step_budget": 100000,
        "policy": { "effects": "unsupported" }
      },
      "expected": [{ "integer": { "value": 1, "type": { "bits": 64, "signed": true } } }],
      "expected_status": "returned"
    },
    {
      "id": "malformed-close",
      "request": {
        "schema_version": "0.1",
        "target": { "module": "examples.json_stream_probe", "function": "inspect" },
        "arguments": [{ "sequence": { "values": [
          { "byte": { "value": 123 } }, { "byte": { "value": 34 } },
          { "byte": { "value": 97 } }, { "byte": { "value": 34 } },
          { "byte": { "value": 58 } }, { "byte": { "value": 93 } }
        ] } }],
        "step_budget": 100000,
        "policy": { "effects": "unsupported" }
      },
      "expected": [{ "integer": { "value": -101, "type": { "bits": 64, "signed": true } } }],
      "expected_status": "returned"
    },
    {
      "id": "incomplete-container",
      "request": {
        "schema_version": "0.1",
        "target": { "module": "examples.json_stream_probe", "function": "inspect" },
        "arguments": [{ "sequence": { "values": [
          { "byte": { "value": 123 } }
        ] } }],
        "step_budget": 100000,
        "policy": { "effects": "unsupported" }
      },
      "expected": [{ "integer": { "value": -1, "type": { "bits": 64, "signed": true } } }],
      "expected_status": "returned"
    },
    {
      "id": "multiple-roots",
      "request": {
        "schema_version": "0.1",
        "target": { "module": "examples.json_stream_probe", "function": "inspect" },
        "arguments": [{ "sequence": { "values": [
          { "byte": { "value": 123 } }, { "byte": { "value": 125 } },
