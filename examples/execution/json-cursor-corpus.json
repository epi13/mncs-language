{
  "schema_version": "0.2",
  "name": "json-cursor",
  "description": "Bounded JSON cursor validity, long-key saturation, and UTF-8 boundary witnesses.",
  "cases": [
    {
      "id": "complete-object",
      "request": {
        "schema_version": "0.1",
        "target": { "module": "examples.json_cursor_probe", "function": "complete" },
        "arguments": [{ "sequence": { "values": [
          { "byte": { "value": 123 } }, { "byte": { "value": 34 } }, { "byte": { "value": 97 } }, { "byte": { "value": 34 } }, { "byte": { "value": 58 } }, { "byte": { "value": 49 } }, { "byte": { "value": 125 } }
        ] } }],
        "step_budget": 100000,
        "policy": { "effects": "unsupported" }
      },
      "expected": [{ "integer": { "value": 1, "type": { "bits": 64, "signed": true } } }],
      "expected_status": "returned"
    },
    {
      "id": "incomplete-object",
      "request": {
        "schema_version": "0.1",
        "target": { "module": "examples.json_cursor_probe", "function": "complete" },
        "arguments": [{ "sequence": { "values": [
          { "byte": { "value": 123 } }, { "byte": { "value": 34 } }, { "byte": { "value": 97 } }, { "byte": { "value": 34 } }, { "byte": { "value": 58 } }, { "byte": { "value": 49 } }
        ] } }],
        "step_budget": 100000,
        "policy": { "effects": "unsupported" }
      },
      "expected": [{ "integer": { "value": 0, "type": { "bits": 64, "signed": true } } }],
      "expected_status": "returned"
    },
    {
      "id": "long-unknown-key-does-not-reject",
      "request": {
        "schema_version": "0.1",
        "target": { "module": "examples.json_cursor_probe", "function": "complete" },
        "arguments": [{ "sequence": { "values": [
          { "byte": { "value": 123 } }, { "byte": { "value": 34 } }, { "byte": { "value": 99 } }, { "byte": { "value": 97 } }, { "byte": { "value": 110 } }, { "byte": { "value": 111 } }, { "byte": { "value": 110 } }, { "byte": { "value": 105 } }, { "byte": { "value": 99 } }, { "byte": { "value": 97 } }, { "byte": { "value": 108 } }, { "byte": { "value": 95 } }, { "byte": { "value": 104 } }, { "byte": { "value": 117 } }, { "byte": { "value": 109 } }, { "byte": { "value": 97 } }, { "byte": { "value": 110 } }, { "byte": { "value": 95 } }, { "byte": { "value": 103 } }, { "byte": { "value": 117 } }, { "byte": { "value": 105 } }, { "byte": { "value": 101 } }, { "byte": { "value": 34 } }, { "byte": { "value": 58 } }, { "byte": { "value": 49 } }, { "byte": { "value": 125 } }
        ] } }],
        "step_budget": 100000,
        "policy": { "effects": "unsupported" }
      },
      "expected": [{ "integer": { "value": 1, "type": { "bits": 64, "signed": true } } }],
      "expected_status": "returned"
    },
    {
      "id": "invalid-utf8",
      "request": {
        "schema_version": "0.1",
        "target": { "module": "examples.json_cursor_probe", "function": "complete" },
        "arguments": [{ "sequence": { "values": [
          { "byte": { "value": 123 } }, { "byte": { "value": 34 } }, { "byte": { "value": 97 } }, { "byte": { "value": 34 } }, { "byte": { "value": 58 } }, { "byte": { "value": 34 } }, { "byte": { "value": 195 } }, { "byte": { "value": 40 } }, { "byte": { "value": 34 } }, { "byte": { "value": 125 } }
        ] } }],
        "step_budget": 100000,
        "policy": { "effects": "unsupported" }
      },
      "expected": [{ "integer": { "value": 0, "type": { "bits": 64, "signed": true } } }],
      "expected_status": "returned"
    }
  ]
}
