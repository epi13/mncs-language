mncs 0.18;
module mncs.language.process_lifecycle_smoke;
use mncs.std.process.v1 as process;
use mncs.std.process.v1;
use mncs.test.assertions;
use mncs.test.suite;

fn request() -> (result: process.ProcessRequest) {
    return process.ProcessRequest {
        program: [47, 117, 115, 114, 47, 98, 105, 110, 47, 115, 108, 101, 101, 112],
        argv: [[49, 48]],
        argv_count: 1,
        current_dir: [],
        environment: [],
        environment_count: 0,
        resources: process.ProcessResourceEnvelope {
            memory_high_bytes: 33554432,
            memory_max_bytes: 67108864,
            swap_max_bytes: 0,
            has_swap_max: true,
            process_max: 16
        },
        stdin: [],
        stdout_limit: 1024,
        stderr_limit: 1024,
        deadline_ms: 30000
    };
}

fn is_running(status: process.ProcessStatus) -> (result: bool) {
    return match status {
        Running => true,
        Exited => false,
        Cancelled => false,
        TimedOut => false,
        ResourceExhausted => false,
        OutputExhausted => false,
        Unsupported => false,
        Unknown => false
    };
}

test cancellation_is_reaped() -> (result: TestResult)
    capability process_capability
    effect process_run authorized_by process_capability
{
    let started: process.ProcessStartResult = process.start(request());
    let before: process.ProcessObservation = process.observe(started.handle);
    let requested: process.ProcessObservation = process.cancel(started.handle);
    let after: process.ProcessObservation = process.reap(started.handle);
    return from_assertion(equals_bool(
        true,
        started.has_handle && is_running(before.status) && before.observation_complete && requested.cancellation_requested &&
        after.cancellation_complete && after.cleanup_complete && after.tree_empty && after.launcher_reaped,
        7101
    ));
}
