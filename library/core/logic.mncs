mncs 0.13;

// mncs.core.logic — total boolean algebra helpers.
//
// Profiles 0.6 and 0.13 provide native boolean operators (`&&`, `||`, `!`,
// `==`/`!=` on bools) as total primitive operations; these helpers name the
// truth tables so larger programs share one executable authority. The
// operator corpus (`pressure-bool-ops`) pins the operators to exactly these
// tables, and `library-core-logic` pins these helpers in return.
//
// All operations are total and effect-free.
module mncs.core.logic.v1;

fn bool_not(a: bool) -> (result: bool) {
    return !a;
}

fn bool_and(a: bool, b: bool) -> (result: bool) {
    return a && b;
}

fn bool_or(a: bool, b: bool) -> (result: bool) {
    return a || b;
}

// Material implication, total on both operands.
fn bool_implies(a: bool, b: bool) -> (result: bool) {
    return (!a) || b;
}

// Exclusive disjunction.
fn bool_xor(a: bool, b: bool) -> (result: bool) {
    return a != b;
}
