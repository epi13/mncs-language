mncs 0.8;

// mncs.core.sequences — reusable operations over bounded sequences.
//
// This module is the standard-library definition of the bounded-data
// substrate's traversal vocabulary (Source Profile 0.7, RFC 0044). Every
// operation is total over its declared domain: lengths are fixed by the
// sequence types themselves, traversal discharges element bounds checks by
// semantics, and no operation allocates or fails. Element bounds facts are
// machine knowledge here, not runtime folklore.
//
// Fixed element counts appear in the type signatures because the substrate
// is deliberately bounded; generalization awaits RFC 0013 polymorphism and
// must not be simulated with unbounded representations.
//
// Realization envelope (2026-08): reference executors, research bytecode,
// portable WASM, C11, LLVM IR, and Cranelift realize these operations,
// including sequence-typed and view-typed language-level signatures, through
// canonical cells (exact sequences) and packed view descriptors. Nested
// composite sequence elements remain a later cell-of-cells step.
module mncs.core.sequences.v1;

enum Found { Yes { value: i64 }, No }

record Scan { prev: i64, ordered: bool }

fn make_found(value: i64) -> (result: Found) {
    return Found.Yes { value: value };
}

fn no_found() -> (result: Found) {
    return Found.No;
}

// Sum of an exact window. Checked accumulation keeps overflow explicit.
fn sum4(a: i64, b: i64, c: i64, d: i64) -> (result: i64) {
    let xs: [i64; 4] = [a, b, c, d];
    iterate i over xs carrying acc: i64 = 0 {
        next acc = acc + xs[i];
    }
    return acc;
}

// Membership test by full deterministic traversal.
fn contains4(xs: [i64; 4], needle: i64) -> (result: bool) {
    iterate i over xs carrying hit: bool = false {
        next hit = hit || xs[i] == needle;
    }
    return hit;
}

// Count of exact matches; the canonical search-shape fold.
fn count4(xs: [i64; 4], needle: i64) -> (result: i64) {
    iterate i over xs carrying hits: i64 = 0 {
        next hits = hits + ((xs[i] == needle) as i64);
    }
    return hits;
}

// First element of a window, as a logical option. The empty case is
// representable because a view may have runtime length zero; observing a
// missing head is a value, never a failure.
fn first_of(view: [i64; up_to 4]) -> (result: Found) {
    if view.len == 0 {
        return Found.No;
    }
    return Found.Yes { value: view[0] };
}

// Last element of a window under the same option discipline.
fn last_of(view: [i64; up_to 4]) -> (result: Found) {
    if view.len == 0 {
        return Found.No;
    }
    return Found.Yes { value: view[view.len - 1] };
}

fn first_or(view: [i64; up_to 4], fallback: i64) -> (result: i64) {
    return match first_of(view) {
        Found.Yes { value } => value,
        No => fallback,
    };
}

fn last_or(view: [i64; up_to 4], fallback: i64) -> (result: i64) {
    return match last_of(view) {
        Found.Yes { value } => value,
        No => fallback,
    };
}

// Strict ordering scan: carries the previous element and the running verdict
// through one traversal. Pairwise adjacency comes from carried state, so no
// index arithmetic beyond the traversal domain is needed.
fn scan_sorted(prev: i64, ordered: bool, next_value: i64) -> (result: Scan) {
    let still: bool = ordered && prev <= next_value;
    return Scan { prev: next_value, ordered: still };
}

fn start_scan(first: i64) -> (result: Scan) {
    return Scan { prev: first, ordered: true };
}

// Non-decreasing check over a fixed window using the scan state machine.
fn is_sorted4(xs: [i64; 4]) -> (result: bool) {
    let seed: Scan = start_scan(xs[0]);
    iterate i over xs carrying state: Scan = seed {
        next state = scan_sorted(state.prev, state.ordered, xs[i]);
    }
    return state.ordered;
}

// Equality of two fixed windows by position-wise conjunction.
fn equals4(left: [i64; 4], right: [i64; 4]) -> (result: bool) {
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

// Positional overwrite of one slot; the canonical functional-update shape
// for fixed windows. Each branch observes exactly the slot it writes.
fn put4(base: [i64; 4], index: u64, value: i64) -> (result: [i64; 4]) {
    if index == 0 {
        return [value, base[1], base[2], base[3]];
    }
    if index == 1 {
        return [base[0], value, base[2], base[3]];
    }
    if index == 2 {
        return [base[0], base[1], value, base[3]];
    }
    return [base[0], base[1], base[2], value];
}

// Comparison-only extrema. No arithmetic, so no overflow obligation.
fn min4(xs: [i64; 4]) -> (result: i64) {
    iterate i over xs carrying acc: i64 = xs[0] {
        next acc = select(xs[i] < acc, xs[i], acc);
    }
    return acc;
}

fn max4(xs: [i64; 4]) -> (result: i64) {
    iterate i over xs carrying acc: i64 = xs[0] {
        next acc = select(xs[i] > acc, xs[i], acc);
    }
    return acc;
}

// First matching index, or 4 when the needle is absent. One-past-end is a
// total missing sentinel that stays inside the declared bound vocabulary.
fn find_index4(xs: [i64; 4], needle: i64) -> (result: i64) {
    iterate i over xs carrying found: i64 = 4 {
        let at: i64 = i as i64;
        let hit: bool = (found == 4) && (xs[i] == needle);
        next found = select(hit, at, found);
    }
    return found;
}

// Prefix/suffix views over a fixed window. The result is a bounded view
// whose runtime length is a type-level fact of the slice endpoints.
fn prefix2(xs: [i64; 4]) -> (result: [i64; up_to 4]) {
    return xs[0..2];
}

fn suffix2(xs: [i64; 4]) -> (result: [i64; up_to 4]) {
    return xs[2..4];
}

// Unsigned 64-bit windows. Identity and first-element access keep the
// high bit through the cell/view ABI rather than wrapping into i64.
fn identity_u64(xs: [u64; 4]) -> (result: [u64; 4]) {
    return xs;
}

fn first_u64(xs: [u64; 4]) -> (result: u64) {
    return xs[0];
}

fn first_u64_view(view: [u64; up_to 4], fallback: u64) -> (result: u64) {
    if view.len == 0 {
        return fallback;
    }
    return view[0];
}

fn contains_byte4(xs: [byte; 4], needle: byte) -> (result: bool) {
    iterate i over xs carrying hit: bool = false {
        next hit = hit || xs[i] == needle;
    }
    return hit;
}

// Boolean windows are not a sequence element type in the current
// envelope. Count nonzero i64 slots instead of pretending `[bool; N]`
// exists as a process-boundary value.
fn count_nonzero4(xs: [i64; 4]) -> (result: i64) {
    iterate i over xs carrying hits: i64 = 0 {
        next hits = hits + ((xs[i] != 0) as i64);
    }
    return hits;
}

fn reverse4(xs: [i64; 4]) -> (result: [i64; 4]) {
    return [xs[3], xs[2], xs[1], xs[0]];
}

fn starts_with2(xs: [i64; 4], a: i64, b: i64) -> (result: bool) {
    return (xs[0] == a) && (xs[1] == b);
}
