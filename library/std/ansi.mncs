mncs 0.8;

// mncs.std.ansi.v1 — bounded ANSI/VT semantic parsing.
//
// This module owns terminal protocol meaning and has no dependency on a TUI
// framework. It emits generic terminal events; an application adapter maps
// those events into its own event vocabulary. The bounded entry point accepts
// at most ten bytes, enough for the common one- and two-digit CSI forms used
// by this vertical slice. Any incomplete, malformed, or unsupported sequence
// is Unknown rather than an inferred stronger event.
module mncs.std.ansi.v1;

enum AnsiEvent {
    Character { codepoint: i64 },
    Escape,
    Arrow { direction: i64, modifiers: i64 },
    Focus { gained: bool },
    PasteStart,
    PasteEnd,
    Mouse { column: i64, row: i64, button: i64, pressed: bool },
    Resize { columns: i64, rows: i64 },
    Unknown { raw: i64 }
}

record ParserState { b0: byte, b1: byte, b2: byte, b3: byte, b4: byte, b5: byte, b6: byte, b7: byte, b8: byte, b9: byte, length: i64 }
record ParseResult { event: AnsiEvent, state: ParserState, complete: bool }

fn parser_init() -> (result: ParserState) {
    return ParserState { b0: 0, b1: 0, b2: 0, b3: 0, b4: 0, b5: 0, b6: 0, b7: 0, b8: 0, b9: 0, length: 0 };
}

fn byte_value(value: byte) -> (result: i64) {
    return value as i64;
}

fn is_digit(value: byte) -> (result: bool) {
    let n: i64 = byte_value(value);
    return n >= 48 && n <= 57;
}

fn one_digit(value: byte) -> (result: i64) {
    return byte_value(value) - 48;
}

fn two_digits(high: byte, low: byte) -> (result: i64) {
    return (one_digit(high) *% 10) +% one_digit(low);
}

fn unknown(raw: i64) -> (result: AnsiEvent) {
    return AnsiEvent.Unknown { raw: raw };
}

fn sequence_event(length: i64, b0: byte, b1: byte, b2: byte, b3: byte, b4: byte, b5: byte, b6: byte, b7: byte, b8: byte, b9: byte) -> (result: AnsiEvent) {
    let v0: i64 = byte_value(b0);
    let v1: i64 = byte_value(b1);
    let v2: i64 = byte_value(b2);
    let v3: i64 = byte_value(b3);
    let v4: i64 = byte_value(b4);
    let v5: i64 = byte_value(b5);
    let v6: i64 = byte_value(b6);
    let v7: i64 = byte_value(b7);
    let v8: i64 = byte_value(b8);
    let v9: i64 = byte_value(b9);
    if length == 0 {
        return unknown(0);
    }
    if length == 1 {
        if v0 >= 32 && v0 <= 126 {
            return AnsiEvent.Character { codepoint: v0 };
        }
        if v0 == 27 {
            return AnsiEvent.Escape;
        }
        return unknown(v0);
    }
    if length == 3 && v0 == 27 && v1 == 91 {
        if v2 == 65 {
            return AnsiEvent.Arrow { direction: 0, modifiers: 0 };
        }
        if v2 == 66 {
            return AnsiEvent.Arrow { direction: 1, modifiers: 0 };
        }
        if v2 == 67 {
            return AnsiEvent.Arrow { direction: 2, modifiers: 0 };
        }
        if v2 == 68 {
            return AnsiEvent.Arrow { direction: 3, modifiers: 0 };
        }
        if v2 == 73 {
            return AnsiEvent.Focus { gained: true };
        }
        if v2 == 79 {
            return AnsiEvent.Focus { gained: false };
        }
    }
    if length == 6 && v0 == 27 && v1 == 91 && v2 == 50 && v3 == 48 && v4 == 48 && v5 == 126 {
        return AnsiEvent.PasteStart;
    }
    if length == 6 && v0 == 27 && v1 == 91 && v2 == 50 && v3 == 48 && v4 == 49 && v5 == 126 {
        return AnsiEvent.PasteEnd;
    }
    // X10 mouse reporting: CSI M Cb Cx Cy, with coordinates biased by 32.
    if length == 6 && v0 == 27 && v1 == 91 && v2 == 77 && v3 >= 32 && v4 >= 32 && v5 >= 32 {
        let button_code: i64 = (v3 - 32) % 4;
        return AnsiEvent.Mouse { column: v4 - 32, row: v5 - 32, button: button_code, pressed: (v3 - 32) < 3 };
    }
    // CSI 8;R;Ct with one digit dimensions.
    if length == 8 && v0 == 27 && v1 == 91 && v2 == 56 && v3 == 59 && v5 == 59 && v7 == 116 && is_digit(b4) && is_digit(b6) {
        return AnsiEvent.Resize { columns: one_digit(b6), rows: one_digit(b4) };
    }
    // CSI 8;RR;CCt with two digit dimensions.
    if length == 10 && v0 == 27 && v1 == 91 && v2 == 56 && v3 == 59 && v6 == 59 && v9 == 116 && is_digit(b4) && is_digit(b5) && is_digit(b7) && is_digit(b8) {
        return AnsiEvent.Resize { columns: two_digits(b7, b8), rows: two_digits(b4, b5) };
    }
    return unknown(v0);
}

fn parse_sequence(length: i64, b0: byte, b1: byte, b2: byte, b3: byte, b4: byte, b5: byte, b6: byte, b7: byte, b8: byte, b9: byte) -> (result: AnsiEvent) {
    let bounded_length: i64 = select(length < 0, 0, select(length > 10, 10, length));
    return sequence_event(bounded_length, b0, b1, b2, b3, b4, b5, b6, b7, b8, b9);
}

fn append(state: ParserState, value: byte) -> (result: ParserState) {
    if state.length == 0 {
        return ParserState { b0: value, b1: state.b1, b2: state.b2, b3: state.b3, b4: state.b4, b5: state.b5, b6: state.b6, b7: state.b7, b8: state.b8, b9: state.b9, length: 1 };
    }
    if state.length == 1 {
        return ParserState { b0: state.b0, b1: value, b2: state.b2, b3: state.b3, b4: state.b4, b5: state.b5, b6: state.b6, b7: state.b7, b8: state.b8, b9: state.b9, length: 2 };
    }
    if state.length == 2 {
        return ParserState { b0: state.b0, b1: state.b1, b2: value, b3: state.b3, b4: state.b4, b5: state.b5, b6: state.b6, b7: state.b7, b8: state.b8, b9: state.b9, length: 3 };
    }
    if state.length == 3 {
        return ParserState { b0: state.b0, b1: state.b1, b2: state.b2, b3: value, b4: state.b4, b5: state.b5, b6: state.b6, b7: state.b7, b8: state.b8, b9: state.b9, length: 4 };
    }
    if state.length == 4 {
        return ParserState { b0: state.b0, b1: state.b1, b2: state.b2, b3: state.b3, b4: value, b5: state.b5, b6: state.b6, b7: state.b7, b8: state.b8, b9: state.b9, length: 5 };
    }
    if state.length == 5 {
        return ParserState { b0: state.b0, b1: state.b1, b2: state.b2, b3: state.b3, b4: state.b4, b5: value, b6: state.b6, b7: state.b7, b8: state.b8, b9: state.b9, length: 6 };
    }
    if state.length == 6 {
        return ParserState { b0: state.b0, b1: state.b1, b2: state.b2, b3: state.b3, b4: state.b4, b5: state.b5, b6: value, b7: state.b7, b8: state.b8, b9: state.b9, length: 7 };
    }
    if state.length == 7 {
        return ParserState { b0: state.b0, b1: state.b1, b2: state.b2, b3: state.b3, b4: state.b4, b5: state.b5, b6: state.b6, b7: value, b8: state.b8, b9: state.b9, length: 8 };
    }
    if state.length == 8 {
        return ParserState { b0: state.b0, b1: state.b1, b2: state.b2, b3: state.b3, b4: state.b4, b5: state.b5, b6: state.b6, b7: state.b7, b8: value, b9: state.b9, length: 9 };
    }
    return ParserState { b0: state.b0, b1: state.b1, b2: state.b2, b3: state.b3, b4: state.b4, b5: state.b5, b6: state.b6, b7: state.b7, b8: state.b8, b9: value, length: 10 };
}

fn parser_feed(state: ParserState, value: byte) -> (result: ParseResult) {
    let appended: ParserState = append(state, value);
    let first: i64 = byte_value(appended.b0);
    if state.length == 0 && first >= 32 && first <= 126 {
        return ParseResult { event: AnsiEvent.Character { codepoint: first }, state: parser_init(), complete: true };
    }
    if state.length == 0 && first != 27 {
        return ParseResult { event: unknown(first), state: parser_init(), complete: true };
    }
    // Keep ESC pending: the following `[` may begin a CSI sequence. A host
    // that wants a standalone Escape can use parse_sequence(1, 27, ...).
    if appended.length == 1 && first == 27 {
        return ParseResult { event: unknown(0), state: appended, complete: false };
    }
    let event: AnsiEvent = sequence_event(appended.length, appended.b0, appended.b1, appended.b2, appended.b3, appended.b4, appended.b5, appended.b6, appended.b7, appended.b8, appended.b9);
    let complete: bool = match event {
        Character { codepoint } => true,
        Escape => appended.length == 1,
        Arrow { direction, modifiers } => true,
        Focus { gained } => true,
        PasteStart => true,
        PasteEnd => true,
        Mouse { column, row, button, pressed } => true,
        Resize { columns, rows } => true,
        Unknown { raw } => appended.length >= 3,
    };
    if complete {
        return ParseResult { event: event, state: parser_init(), complete: true };
    }
    return ParseResult { event: unknown(0), state: appended, complete: false };
}

fn ansi_event_is_unknown(event: AnsiEvent) -> (result: bool) {
    return match event {
        Unknown { raw } => true,
        Character { codepoint } => false,
        Escape => false,
        Arrow { direction, modifiers } => false,
        Focus { gained } => false,
        PasteStart => false,
        PasteEnd => false,
        Mouse { column, row, button, pressed } => false,
        Resize { columns, rows } => false,
    };
}
