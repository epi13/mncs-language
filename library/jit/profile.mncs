mncs 0.13;

// mncs.jit.profile — execution observations and tiering hooks for the
// MNCS-native JIT orchestration layer.
//
// A Profile is per-(logical, generation, provider) accounting owned
// by the session layer; the host threads wall-clock milliseconds in
// (the `clock` pattern: time enters only as host observations, never
// as ambient reads). Observations are total and saturating: counters
// pin at u64 MAX instead of wrapping, so a hot loop can never turn
// its own accounting into a cold reading.
//
// This module deliberately stops at hooks: call/execution/compile
// accounting, means, and threshold-gated candidacy. Adaptive
// optimization policy lives above (see `mncs.jit.plan.v1`); the only
// contract here is that every number a future tiering policy needs
// is already recorded with explicit units (milliseconds).
//
// Complexity bounds: every observation is O(1). No operation
// allocates; every function is total.
module mncs.jit.profile.v1;

use mncs.core.logic.v1 as logic;

// Per-executable-generation accounting. provider_code and generation
// identify the subject; the session layer re-keys on republication.
record Profile {
    calls: u64,
    exec_ms_total: u64,
    compile_ms_total: u64,
    last_exec_ms: u64,
    provider_code: u64,
    generation: u64,
}

fn profile_zero() -> (result: Profile) {
    return Profile { calls: 0, exec_ms_total: 0, compile_ms_total: 0, last_exec_ms: 0, provider_code: 0, generation: 0 };
}

// Saturating addition: pins at u64 MAX (18446744073709551615).
// Wrapping here would be dishonest accounting, so the bound is
// checked before the add and no trap is possible.
fn saturating_add(a: u64, b: u64) -> (result: u64) {
    let max: u64 = 18446744073709551615;
    if a > max -% b {
        return max;
    }
    return a +% b;
}

// Record one invocation observed at `exec_ms` milliseconds.
fn observe_call(p: Profile, exec_ms: u64, provider_code: u64, generation: u64) -> (result: Profile) {
    return Profile {
        calls: saturating_add(p.calls, 1),
        exec_ms_total: saturating_add(p.exec_ms_total, exec_ms),
        compile_ms_total: p.compile_ms_total,
        last_exec_ms: exec_ms,
        provider_code: provider_code,
        generation: generation,
    };
}

// Record one compilation observed at `compile_ms` milliseconds.
fn observe_compile(p: Profile, compile_ms: u64) -> (result: Profile) {
    return Profile {
        calls: p.calls,
        exec_ms_total: p.exec_ms_total,
        compile_ms_total: saturating_add(p.compile_ms_total, compile_ms),
        last_exec_ms: p.last_exec_ms,
        provider_code: p.provider_code,
        generation: p.generation,
    };
}

// Mean execution milliseconds per call; 0 before any call. The
// division sits behind the zero guard because `select` is strict.
fn mean_exec_ms(p: Profile) -> (result: u64) {
    if p.calls == 0 {
        return 0;
    } else {
    }
    return p.exec_ms_total / p.calls;
}

// True once the subject has served at least `min_calls` calls. The
// threshold is a parameter: steady-state detection policy lives
// above this module.
fn is_steady(p: Profile, min_calls: u64) -> (result: bool) {
    return p.calls >= min_calls;
}

// --- Executable entry points (scalar shapes for backend corpora) ---

// Saturation edge: MAX stays MAX under further adds, and MAX -% b
// arithmetic never traps.
fn candidate_saturation() -> (result: i64) {
    let top: u64 = saturating_add(18446744073709551615, 1);
    let near: u64 = saturating_add(18446744073709551610, 4);
    let past: u64 = saturating_add(18446744073709551610, 5);
    let plain: u64 = saturating_add(100, 23);
    return select(top == 18446744073709551615, 1000, 0) as i64
        +% select(near == 18446744073709551614, 100, 0) as i64
        +% select(past == 18446744073709551615, 10, 0) as i64
        +% select(plain == 123, 1, 0) as i64;
}

// Observe chain: two calls (4ms, 6ms) plus a 50ms compile on
// provider 1 generation 3. calls=2, total=10, mean=5, compile=50,
// last=6, steady at 2 but not at 3.
fn candidate_observe_chain() -> (result: i64) {
    let p0: Profile = profile_zero();
    let p1: Profile = observe_call(p0, 4, 1, 3);
    let p2: Profile = observe_call(p1, 6, 1, 3);
    let p3: Profile = observe_compile(p2, 50);
    return p3.calls as i64 *% 100000000
        +% p3.exec_ms_total as i64 *% 1000000
        +% mean_exec_ms(p3) as i64 *% 100000
        +% p3.compile_ms_total as i64 *% 1000
        +% p3.last_exec_ms as i64 *% 10
        +% select(is_steady(p3, 2), 1, 0) as i64
        +% select(is_steady(p3, 3), 0, 0) as i64;
}

// Mean before any call is 0 (no division executed); a fresh profile
// is not steady at 1.
fn candidate_empty_profile() -> (result: i64) {
    let p0: Profile = profile_zero();
    return mean_exec_ms(p0) as i64 *% 10 +% select(is_steady(p0, 1), 1, 0) as i64;
}
